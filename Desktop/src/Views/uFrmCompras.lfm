    end
    object edtTotal: TEdit
      Left = 530
      Height = 25
      Top = 24
      Width = 110
      ReadOnly = True
      Alignment = taRightJustify
      TabOrder = 1
      Text = '0,00'
    end
    object lblObs: TLabel
      Left = 16
      Height = 16
      Top = 8
      Width = 85
      Caption = 'Observações:'
    end
    object mmoObs: TMemo
      Left = 16
      Height = 28
      Top = 24
      Width = 360
      TabOrder = 2
    end
  end
  object pnlBotoes: TPanel
    Left = 0
    Height = 50
    Top = 480
    Width = 900
    Align = alBottom
    TabOrder = 4
    object btnSalvar: TBitBtn
      Left = 16
      Height = 32
      Top = 8
      Width = 110
      Caption = 'Salvar'
      OnClick = btnSalvarClick
      TabOrder = 0
    end
    object btnConfirmar: TBitBtn
      Left = 136
      Height = 32
      Top = 8
      Width = 130
      Caption = 'Confirmar'
      OnClick = btnConfirmarClick
      TabOrder = 1
    end
    object btnCancelar: TBitBtn
      Left = 276
      Height = 32
      Top = 8
      Width = 110
      Caption = 'Cancelar'
      OnClick = btnCancelarClick
      TabOrder = 2
