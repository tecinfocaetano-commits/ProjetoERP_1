    Align = alBottom
    TabOrder = 3
    object lblSubtotal: TLabel
      Left = 400
      Height = 16
      Top = 8
      Width = 55
      Caption = 'Subtotal:'
    end
    object edtSubtotal: TEdit
      Left = 400
      Height = 25
      Top = 24
      Width = 110
      ReadOnly = True
      Alignment = taRightJustify
      TabOrder = 0
