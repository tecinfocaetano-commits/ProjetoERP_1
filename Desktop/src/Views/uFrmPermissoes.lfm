object frmPermissoes: TfrmPermissoes
  Height = 520
  Width = 760
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  Caption = 'Permissões'
  object pnlTopo: TPanel
    Left = 0
    Height = 40
    Top = 0
    Width = 744
    Align = alTop
    BevelOuter = bvNone
    object lblTitulo: TLabel
      Left = 16
      Height = 16
      Top = 12
      Width = 220
      Caption = 'Permissões por Grupo'
      Font.Style = [fsBold]
      ParentFont = False
    end
  end
  object pnlGrupo: TPanel
    Left = 0
    Height = 40
    Top = 40
    Width = 744
    Align = alTop
    BevelOuter = bvNone
