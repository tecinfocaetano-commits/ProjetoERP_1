      Height = 25
      Top = 8
      Width = 240
      Style = csDropDownList
      TabOrder = 0
      OnChange = cmbGrupoChange
    end
    object lblDica: TLabel
      Left = 328
      Height = 16
      Top = 12
      Width = 400
      Caption = 'Clique numa linha da grade para editar. "Novo" cadastra outra tela.'
    end
  end
  object dbGrid: TDBGrid
    Left = 0
    Height = 250
    Top = 80
    Width = 744
    Align = alClient
    Columns = <
      item
        Expanded = False
        FieldName = 'ID'
        Title.Caption = 'ID'
        Width = 50
        Visible = True
      end
      item
        Expanded = False
        FieldName = 'MODULO'
        Title.Caption = 'M'#243'dulo'
        Width = 130
        Visible = True
      end
      item
        Expanded = False
        FieldName = 'TELA'
        Title.Caption = 'Tela'
        Width = 170
        Visible = True
      end
      item
        Expanded = False
        FieldName = 'PODE_VISUALIZAR'
        Title.Caption = 'Ver'
        Width = 45
        Visible = True
      end
      item
        Expanded = False
        FieldName = 'PODE_INSERIR'
        Title.Caption = 'Inserir'
        Width = 55
        Visible = True
      end
      item
        Expanded = False
        FieldName = 'PODE_EDITAR'
        Title.Caption = 'Editar'
        Width = 55
        Visible = True
      end
      item
        Expanded = False
        FieldName = 'PODE_EXCLUIR'
        Title.Caption = 'Excluir'
        Width = 55
        Visible = True
      end
      item
        Expanded = False
        FieldName = 'PODE_IMPRIMIR'
        Title.Caption = 'Imprimir'
        Width = 60
        Visible = True
      end>
    DataSource = DataSource1
    Options = [dgTitles, dgIndicator, dgColumnResize, dgColLines, dgRowLines, dgRowSelect, dgAlwaysShowSelection]
    ReadOnly = True
    TabOrder = 1
    OnCellClick = dbGridCellClick
  end
