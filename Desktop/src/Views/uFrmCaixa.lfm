object frmCaixa: TfrmCaixa
  Height = 540
  Width = 840
  OnCreate = FormCreate
  Caption = 'Caixa'
  object pnlTopo: TPanel
    Left = 0
    Height = 40
    Top = 0
    Width = 824
    Align = alTop
    BevelOuter = bvNone
    object lblTitulo: TLabel
      Left = 16
      Height = 16
      Top = 12
      Width = 260
      Caption = 'Caixas da Empresa'
      Font.Style = [fsBold]
      ParentFont = False
    end
    object btnAtualizar: TBitBtn
      Left = 626
      Height = 30
      Top = 4
      Width = 80
      Caption = '&Atualizar'
      OnClick = btnAtualizarClick
      TabOrder = 1
    end
    object btnFechar: TBitBtn
      Left = 710
      Height = 30
      Top = 4
      Width = 90
      Caption = '&Fechar'
      OnClick = btnFecharClick
      TabOrder = 2
    end
    object lblPesquisa: TLabel
      Left = 290
      Height = 16
      Top = 12
      Width = 55
      Caption = 'Pesquisar:'
    end
    object edtPesquisa: TEdit
      Left = 348
      Height = 25
      Top = 7
      Width = 200
      OnKeyPress = edtPesquisaKeyPress
      TabOrder = 3
    end
    object btnPesquisar: TBitBtn
      Left = 552
      Height = 30
      Top = 4
      Width = 70
      Caption = '&Buscar'
      OnClick = btnPesquisarClick
      TabOrder = 4
    end
  end
  object dbGridCaixas: TDBGrid
    Left = 0
    Height = 200
    Top = 40
    Width = 824
    Align = alTop
    DataSource = DataSource1
    Options = [dgTitles, dgIndicator, dgColumnResize, dgColLines, dgRowLines, dgRowSelect, dgAlwaysShowSelection]
    TabOrder = 1
    OnCellClick = dbGridCaixasCellClick
  end
  object pnlResumo: TPanel
    Left = 0
    Height = 36
    Top = 240
    Width = 824
    Align = alTop
    BevelOuter = bvNone
    object lblEntradas: TLabel
      Left = 16
      Height = 16
      Top = 10
      Width = 140
      Caption = 'Entradas: 0.00'
    end
    object lblSaidas: TLabel
      Left = 220
      Height = 16
      Top = 10
      Width = 120
      Caption = 'Saídas: 0.00'
    end
    object lblSaldo: TLabel
      Left = 420
      Height = 16
      Top = 10
      Width = 160
      Caption = 'Saldo: 0.00'
      Font.Style = [fsBold]
      ParentFont = False
    end
  end
  object dbGridMovimentos: TDBGrid
    Left = 0
    Height = 244
    Top = 276
    Width = 824
    Align = alClient
    DataSource = DataSource2
