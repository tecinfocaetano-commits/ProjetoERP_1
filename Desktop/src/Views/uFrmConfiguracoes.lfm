inherited frmConfiguracoes: TfrmConfiguracoes
  Height = 420
  Width = 680
  OnDestroy = FormDestroy
  Caption = 'Configurações do Sistema'
  inherited pnlTopo: TPanel
    object chkUsaGrade: TCheckBox
      Left = 300
      Height = 22
      Top = 16
      Width = 370
      Caption = 'Usar grade de tamanhos no pedido e no mapa'
      Font.Color = clWhite
      ParentFont = False
      TabOrder = 0
      OnClick = chkUsaGradeClick
    end
  end
  inherited PageControl1: TPageControl
    inherited tsCadastro: TTabSheet
      object lblChave: TLabel
        Left = 16
        Height = 16
        Top = 10
        Width = 60
        Caption = 'Chave: *'
        Font.Style = [fsBold]
        ParentFont = False
      end
      object edtChave: TEdit
        Left = 16
        Height = 25
        Top = 28
        Width = 300
        MaxLength = 50
        TabOrder = 0
      end
      object lblValor: TLabel
        Left = 16
        Height = 16
        Top = 62
        Width = 40
        Caption = 'Valor:'
      end
      object edtValor: TEdit
        Left = 16
        Height = 25
        Top = 80
        Width = 500
        MaxLength = 255
        TabOrder = 1
      end
      object lblDescricao: TLabel
        Left = 16
        Height = 16
        Top = 114
        Width = 70
        Caption = 'Descrição:'
      end
      object edtDescricao: TEdit
        Left = 16
        Height = 25
        Top = 132
        Width = 500
        MaxLength = 255
        TabOrder = 2
      end
    end
  end
end
